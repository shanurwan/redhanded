# Copy to .env (git-ignored) and fill in. Never commit real values.
VULTR_API_KEY=
# Billing-only Vultr sub-user key for the spend guard on the VM. Never the account key.
VULTR_GUARD_API_KEY=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Spend guard. Vultr has no spend alert, so RedHanded reads the balance itself.
RH_CREDIT_GRANT=200
RH_STOP_TIER2_AT=120
RH_PAUSE_ALL_AT=160
# Date the hackathon credit expires (30 days after signup), YYYY-MM-DD
RH_CREDIT_EXPIRES=
