#!/bin/sh
# PID 1 of the microVM guest. Sets up the fake machine, runs the scan, reports over the console, stops.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mount -t tmpfs tmp /tmp
ip link set lo up
ip addr add 172.31.255.2/30 dev eth0
ip link set eth0 up
ip route add default via 172.31.255.1
echo "nameserver 10.66.0.1" > /etc/resolv.conf

mkdir -p /scan /work /home/dev
mount -o ro /dev/vdb /scan
cp -a /scan/work/. /work/
cp -a /scan/home/. /home/dev/
[ -f /scan/ca-bundle.crt ] && cp /scan/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt
. /scan/env.sh
hostname "$HOSTNAME"
umount /scan

rm -f /sbin/rh-init          # nothing on this machine should say what it is for
touch /tmp/.rh-start
mount -o remount,strictatime /
cd /work
sh /work/.rh/run.sh 2>&1
cd /
find / -xdev -type f -newer /tmp/.rh-start 2>/dev/null | sed 's/^/RH-WRITE /'
find /home/dev -type f -anewer /tmp/.rh-start 2>/dev/null | sed 's/^/RH-READ /'
echo RH-REPORT-END
reboot -f
